# =============================================================================
# Wallet Manager — Example Environment
# Copy to .env, fill the placeholders, then run scripts/setup_wizard.py
# =============================================================================

VAULT_KEY=GENERATE_WITH_FERNET
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

BASE_RPC_1=https://mainnet.base.org
BASE_RPC_2=https://base.drpc.org
BASE_RPC_3=

PRIVATE_RPC_1=
PRIVATE_RPC_2=
PRIVATE_RPC_3=

EXECUTION_MODE=robust_paper
WALLET_CONFIG_PATH=wallets.json

YIELD_WEIGHT=0.40
ALGO_WEIGHT=0.35
SHORT_WEIGHT=0.10
AIRDROP_WEIGHT=0.15
MONTHLY_INJECTION_USD=150.0
REBALANCE_DRIFT_THRESHOLD=0.05

LOG_LEVEL=INFO
LOG_FORMAT=text

METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_HOST=0.0.0.0

TELEGRAM_RATE_LIMIT=1.0
TELEGRAM_RATE_BURST=1

TRADE_JOURNAL_PATH=trade_journal.jsonl
TRADE_JOURNAL_MAX_MB=100.0

PAPER_TRADE=true
PAPER_INITIAL_BALANCE_USD=140.0
LIVE_TRADING_ENABLED=false
LIVE_TINY_CAP_MODE=true
LIVE_MAX_TOTAL_CAPITAL_USD=250.0
LIVE_MAX_WALLETS=1
AUDIT_SNAPSHOT_ENABLED=true
AUDIT_RECENT_SESSIONS_LIMIT=25

RETRY_ATTEMPTS=4
RETRY_BASE_DELAY=1.5
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT=30.0
MAX_CONCURRENT_WALLETS=5
GAS_POLL_INTERVAL=30.0
LOOP_INTERVAL_SECONDS=45.0
ALGO_LOOP_INTERVAL_SECONDS=300.0
KELLY_FRACTION=0.25
ML_CONFIDENCE_THRESHOLD=0.65

ALERTMANAGER_WEBHOOK_ENABLED=false
ALERTMANAGER_WEBHOOK_PORT=9093

SUBGRAPH_URL=
